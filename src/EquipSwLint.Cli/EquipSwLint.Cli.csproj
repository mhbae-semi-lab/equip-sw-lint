<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet tool: analyzes a folder of .cs files without building it (equipment code often needs vendor SDKs CI does not have). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>equip-sw-lint</AssemblyName>
    <RootNamespace>EquipSwLint.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>equip-sw-lint</ToolCommandName>
    <PackageId>equip-sw-lint</PackageId>
    <Description>Command-line runner for EquipSwLint analyzers: analyzes C# sources without building, writes SARIF 2.1.0 and HTML, supports a baseline gate.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.13" />
    <ProjectReference Include="../EquipSwLint.Analyzers/EquipSwLint.Analyzers.csproj" />
    <None Include="../../docs/nuget/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
